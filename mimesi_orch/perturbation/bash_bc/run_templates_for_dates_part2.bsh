#!/bin/bash

format_date() {
    date -I -d "$1"
}
# hours=(03 06 09 12 15 18 21 00)
start_date="2023-08-04"
end_date="2023-08-04"
#source test_newlib.txt
current_date=$(format_date "$start_date")
end_date=$(format_date "$end_date")
cd /gporq3/minni/FARM-DART/perturbation_fields/data/bc_base_test/submit_daily/
queue=cresco6_h144
while [ "$current_date" != "$(format_date "$end_date + 1 day")" ]; do
	echo "Running template.bsh for date: $current_date"
    bsub -n 4 -q ${queue} -o ${current_date}_pert_no2_bc1.out -e ${current_date}_pert_no2_bc1.err ./perturb_boundary_files_part2.bsh "$current_date"
    current_date=$(format_date "$current_date + 1 day")
done
